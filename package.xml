<?xml version="1.0"?>
<package format="2">
  <name>corridor_classifier</name>
  <version>0.1.0</version>
  <description>DINOv2-based corridor shape and turning-state classifier for ROS.</description>

  <maintainer email="takumi@example.com">takumi</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>python3-setuptools</build_depend>

  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>rospy</depend>
  <depend>scenario_navigation_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-setuptools</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-tqdm</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>unidepth_ros</exec_depend>

  <export/>
</package>
