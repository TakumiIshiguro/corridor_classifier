<?xml version="1.0"?>
<launch>
  <!-- Production settings live in config/ itself. The checkpoint there is
       trained on sessions a-h only; i-n are intentionally never used for
       fitting or checkpoint selection, so they remain available as a
       genuine unseen-environment check. See
       config/experiments/TRAIN_ONLY_SESSIONS_DECISION.md. -->
  <arg name="config_dir" default="$(find corridor_classifier)/config"/>
  <arg name="checkpoint_path_override" default=""/>
  <arg name="device_override" default=""/>
  <arg name="inference_rate_override" default="0.0"/>
  <!-- Empty keeps runtime.bev_max_time_difference_seconds from model.yaml. -->
  <arg name="bev_max_time_difference_seconds" default=""/>
  <!-- Set to true only if nothing else (e.g. vnm_ros/care_navigation.launch)
       is already publishing /unidepth/depth; defaults to false to avoid
       starting UniDepth twice. -->
  <arg name="start_depth_estimator" default="false"/>
  <arg name="unidepth_config_file"
       default="$(find unidepth_ros)/config/unidepth.yaml"/>
  <arg name="unidepth_model_path_override" default=""/>
  <arg name="unidepth_device_override" default=""/>
  <arg name="unidepth_inference_rate_override" default="0.0"/>

  <include file="$(find unidepth_ros)/launch/unidepth.launch" if="$(arg start_depth_estimator)">
    <arg name="config_file" value="$(arg unidepth_config_file)"/>
    <arg name="model_path_override" value="$(arg unidepth_model_path_override)"/>
    <arg name="device_override" value="$(arg unidepth_device_override)"/>
    <arg name="inference_rate_override" value="$(arg unidepth_inference_rate_override)"/>
  </include>

  <node
    pkg="corridor_classifier"
    type="corridor_classifier_node.py"
    name="corridor_classifier"
    output="screen"
    required="true">
    <param name="config_dir" value="$(arg config_dir)"/>
    <param name="checkpoint_path_override" value="$(arg checkpoint_path_override)"/>
    <param name="device_override" value="$(arg device_override)"/>
    <param name="inference_rate_override" value="$(arg inference_rate_override)"/>
    <param name="bev_max_time_difference_seconds" type="str"
           value="$(arg bev_max_time_difference_seconds)"/>
  </node>
</launch>
