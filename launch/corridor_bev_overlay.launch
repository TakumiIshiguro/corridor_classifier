<launch>
  <arg name="config_dir" default="$(find corridor_classifier)/config"/>
  <arg name="output_topic" default="/corridor_classifier/bev_overlay"/>
  <arg name="show_image" default="true"/>

  <node pkg="corridor_classifier" type="corridor_bev_overlay.py" name="corridor_bev_overlay" output="screen">
    <param name="config_dir" value="$(arg config_dir)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
  </node>

  <node pkg="image_view" type="image_view" name="corridor_bev_view" if="$(arg show_image)">
    <remap from="image" to="$(arg output_topic)"/>
  </node>
</launch>
