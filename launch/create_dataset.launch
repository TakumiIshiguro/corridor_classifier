<?xml version="1.0"?>
<launch>
  <arg name="config_dir" default="$(find corridor_classifier)/config"/>
  <arg name="dataset_type_override" default=""/>
  <arg name="session_name_override" default=""/>

  <node
    pkg="corridor_classifier"
    type="create_dataset.py"
    name="corridor_dataset_collector"
    output="screen"
    required="true">
    <param name="config_dir" value="$(arg config_dir)"/>
    <param name="dataset_type_override" value="$(arg dataset_type_override)"/>
    <param name="session_name_override" value="$(arg session_name_override)"/>
  </node>
</launch>
