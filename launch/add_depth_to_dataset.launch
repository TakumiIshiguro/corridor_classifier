<?xml version="1.0"?>
<launch>
  <arg name="config_dir" default="$(find corridor_classifier)/config"/>

  <node
    pkg="corridor_classifier"
    type="add_depth_to_dataset.py"
    name="corridor_dataset_depth_generator"
    output="screen"
    required="true"
    args="--config-dir $(arg config_dir)"/>
</launch>
