<?xml version="1.0"?>
<launch>
  <!-- Trained on sessions a-h only; i-n are intentionally never used for
       fitting or hyperparameter selection, so they remain available as a
       genuine unseen-environment check. See
       config/experiments/TRAIN_ONLY_SESSIONS_DECISION.md. -->
  <arg name="checkpoint_path" default="$(find corridor_classifier)/weights/production/linear_probe_regional5_trainonly.pth"/>
  <arg name="device_override" default="auto"/>
  <arg name="image_topic" default="/camera_center/image_raw"/>
  <arg name="depth_topic" default="/unidepth/depth"/>
  <arg name="passage_type_topic" default="/passage_type"/>
  <arg name="probabilities_topic" default="/corridor_classifier/probabilities"/>
  <arg name="inference_rate" default="4.0"/>
  <!-- Inference is skipped entirely and /passage_type publishes "turning"
       instead, since the model is not trained to classify passage shape
       mid-turn, whenever BOTH hold: scenario_navigation is commanding
       something other than straight ([1,0,0]) on cmd_dir_topic, AND the
       robot's actual /cmd_vel.angular.z is at or above the threshold
       below. cmd_dir alone is not enough (stop, [0,0,0], is "not
       straight" too but is not turning); cmd_vel alone is not enough
       either (vnm_ros/CARE's own obstacle-avoidance steering can produce
       a large angular velocity while scenario_navigation still commands
       straight); requiring both rules out CARE without a separate
       CARE-avoidance signal. 0.20 was too high to ever trigger under
       vnm_ros/CARE driving: measured /cmd_vel.angular.z peaked around
       0.10-0.15 rad/s during real turns there (vs. scenario_navigation's
       more abrupt, larger commanded turns). 0.20 matches the threshold
       already used to label "turning" when building the training dataset
       (see config/dataset.yaml's turn_detection.angular_speed_threshold_rad_s),
       so runtime and training agree on what counts as turning. -->
  <arg name="cmd_dir_topic" default="/cmd_dir_intersection"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="turning_angular_speed_threshold_rad_s" default="0.20"/>
  <arg name="turning_stale_timeout_seconds" default="1.0"/>
  <!-- A raw prediction must be seen this many consecutive frames before it
       can switch /passage_type at all (even the very first switch, e.g.
       right after a turn resets the debouncer), so a single noisy frame
       can never alone become the published value. -->
  <arg name="direction_min_confirm_frames" default="3"/>
  <!-- scenario_navigation's cmd_dir_executor publishes the intersection
       labels (comma-separated, std_msgs/String) that currently satisfy the
       active target; while a turn step is active, this looks ahead to
       the step the turn leads into. A raw prediction matching one of them
       while still turning is published immediately instead of "turning".
       Harmless when scenario_navigation is not running: with no publisher
       on this topic, this stays disabled and turning is always reported
       as "turning". Set to "" to disable explicitly. -->
  <arg name="scenario_target_labels_topic" default="/scenario_target_labels"/>

  <node
    pkg="corridor_classifier"
    type="linear_probe_node.py"
    name="corridor_classifier_linear_probe"
    output="screen"
    required="true">
    <param name="checkpoint_path" value="$(arg checkpoint_path)"/>
    <param name="device_override" value="$(arg device_override)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="passage_type_topic" value="$(arg passage_type_topic)"/>
    <param name="probabilities_topic" value="$(arg probabilities_topic)"/>
    <param name="inference_rate" value="$(arg inference_rate)"/>
    <param name="cmd_dir_topic" value="$(arg cmd_dir_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="turning_angular_speed_threshold_rad_s" value="$(arg turning_angular_speed_threshold_rad_s)"/>
    <param name="turning_stale_timeout_seconds" value="$(arg turning_stale_timeout_seconds)"/>
    <param name="direction_min_confirm_frames" value="$(arg direction_min_confirm_frames)"/>
    <param name="scenario_target_labels_topic" value="$(arg scenario_target_labels_topic)"/>
  </node>
</launch>
